let pages = ["header", "core", "army_selection", "missions", "footer"]

fun file(page) {
    return "src/markdown/{page}.md"
}

fun files() {
    let r = []
    for page in pages {
        r = r + [file(page)]
    }
    return r
}

main {
    // Render maps before pandoc: missions.md references the generated SVGs,
    // so they must exist in static/maps/ before pandoc runs.
    $ mise exec -- node maps/render.js $ failed {
        echo("Error rendering mission maps")
        exit(1)
    }

    const files = files()

    $ pandoc -o index.html -c static/style.css -s --toc --toc-depth=2 {files} $ failed {
        echo("Error running pandoc")
        exit(1)
    }
}