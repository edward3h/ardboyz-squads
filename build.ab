let pages = ["header", "core", "army_selection", "missions", "footer"]

fun file(page) {
    return "src/markdown/{page}.md"
}

fun files() {
    let r = []
    for page in pages {
        r = r + [file(page)]
    }
    return r
}

main {
    const files = files()

    $ pandoc -o index.html -c static/style.css -s --toc --toc-depth=2 {files} $ failed {
        echo("Error running pandoc")
        exit(1)
    }
}